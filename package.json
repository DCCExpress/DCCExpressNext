{
  "name": "dcc-express",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "mobile",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace client run dev",
    "dev:mobile": "npm --workspace mobile run dev",
    "dev:server": "npm --workspace server run dev",
    "typecheck:client": "npm --workspace client run typecheck",
    "typecheck:mobile": "npm --workspace mobile run typecheck",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck": "npm run typecheck:client && npm run typecheck:mobile && npm run typecheck:server",
    "build:client": "npm --workspace client run build",
    "build:mobile": "npm --workspace mobile run build",
    "build:server": "npm --workspace server run build",
    "build": "npm run build:client && npm run build:server",
    "check": "npm run typecheck && npm run build",
    "preflight": "npm run check",
    "audit": "npm audit --workspaces --audit-level=moderate",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "rebuild": "npm run clean && npm run build",
    "preview:client": "npm --workspace client run preview",
    "preview:mobile": "npm --workspace mobile run preview",
    "start:server": "node ./dist/server/server/src/index.js",
    "start": "npm run start:server"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/form": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@tabler/icons-react": "^3.42.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.14.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
