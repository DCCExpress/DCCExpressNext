# DCCExpress environment examples
# Copy this file to .env if your runtime setup loads .env files,
# or set the variables directly in your shell before starting the server.

# Server HTTP/WebSocket port.
# PORT is also supported by the server.
# Default: 3000
DCCEXPRESS_PORT=3000

# Enables all general debug logs.
# Default: off
DCCEXPRESS_DEBUG=0

# Enables verbose Z21-related logs.
# Default: off
DCCEXPRESS_LOG_Z21=0

# Enables verbose DCC-EX-related logs.
# Default: off
DCCEXPRESS_LOG_DCCEX=0

# Enables verbose WebSocket-related logs.
# Default: off
DCCEXPRESS_LOG_WS=0

# Server runtime statistics publish interval in milliseconds.
# Minimum: 1000
# Default: 5000
DCCEXPRESS_RUNTIME_STATS_MS=5000
